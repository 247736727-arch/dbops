# .env.example —— 复制为 .env 后按需修改（.env 已在 .gitignore 中，绝不入库）
#
# 生成加密密钥：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 生成 Django SECRET_KEY：
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ---------------------------------------------------------------- 基础
# 生产必须设为 0。DEBUG=1 时若未配置 FIELD_ENCRYPTION_KEYS，
# 会临时从 SECRET_KEY 派生密钥（仅限本地开发，生产禁止依赖）
DEBUG=1
# SECRET_KEY=请替换为随机值，切勿使用默认值入库
# 多个域名/Host 用逗号分隔
ALLOWED_HOSTS=127.0.0.1,localhost,testserver

# ------------------------------------------------------------ 敏感字段加密
# **必填（生产）**：逗号分隔的多把 Fernet 密钥，第一把用于加密，其余用于解密。
# 多把密钥是为了平滑轮换：新密钥放最前、旧密钥留在后面即可兼容历史密文。
# FIELD_ENCRYPTION_KEYS=Lj6yuxjH6ut5ZNew95LJJe_9GyVjWtMcRUqRl-CnE94=

# ---------------------------------------------------------------- 数据库
# 本地默认 sqlite（零依赖启动）；Docker/生产切到 postgres
# DATABASE_URL=postgres://dbops:dbops@localhost:5432/dbops

# ---------------------------------------------------------------- Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ------------------------------------------------------------ 探测与轮换策略
# 端口探测超时（秒）。不设超时是不可接受的：不可达目标会长期占用 worker
PROBE_TIMEOUT_SECONDS=3.0
# 密码轮换周期（小时）
PASSWORD_ROTATION_INTERVAL_HOURS=12
# 旧密码保留窗口（小时），避免应用侧连接瞬间全部失败
PREVIOUS_PASSWORD_GRACE_HOURS=24
# 单批次最多处理多少实例，超出留到下一次调度
ROTATION_BATCH_SIZE=500
